{
  "manifest_version": 3,
  "name": "Moekura Uploader",
  "version": "0.1.0",
  "description": "Clone a post from another booru to your Moekura site in one click, with its tags, rating and source.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/settings.js", "src/background.js"]
  },
  "action": {
    "default_title": "Clone to Moekura",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Clone the post on this page to Moekura"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "*://*.donmai.us/*",
    "*://*.donmai.moe/*",
    "*://*.e621.net/*",
    "*://*.e926.net/*",
    "*://*.gelbooru.com/*",
    "*://*.safebooru.org/*",
    "*://*.tbib.org/*",
    "*://*.rule34.xxx/*",
    "*://*.yande.re/*",
    "*://*.konachan.com/*",
    "*://*.konachan.net/*",
    "*://*.rule34.us/*",
    "*://*.zerochan.net/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.donmai.us/posts/*",
        "*://*.donmai.moe/posts/*",
        "*://e621.net/posts/*",
        "*://e926.net/posts/*",
        "*://gelbooru.com/index.php*",
        "*://www.gelbooru.com/index.php*",
        "*://safebooru.org/index.php*",
        "*://tbib.org/index.php*",
        "*://rule34.xxx/index.php*",
        "*://yande.re/post/show/*",
        "*://konachan.com/post/show/*",
        "*://konachan.net/post/show/*",
        "*://rule34.us/index.php*",
        "*://www.zerochan.net/*",
        "*://zerochan.net/*"
      ],
      "js": ["src/content/sites.js", "src/content/button.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "moekura-uploader@moe-studios",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
